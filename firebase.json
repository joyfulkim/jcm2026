{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "storage.rules",
      "apps-script.gs",
      "DESIGN.md",
      "jesus-mission-logo.png",
      "firebase-debug.log",
      ".DS_Store",
      ".git/**",
      ".claude/**",
      ".local-backup-before-github-sync-20260513/**",
      "**/.*",
      "**/node_modules/**",
      "stitch/**"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "firebase-client.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
